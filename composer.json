{
    "name": "umer936/cakephp-datatables",
    "description": "jQuery-free DataTables 3 integration for CakePHP 5",
    "homepage": "https://github.com/umer936/cakephp-datatables",
    "type": "cakephp-plugin",
    "keywords": ["cakephp", "datatables"],
    "license": "MIT",
    "authors": [
        {
            "name": "Frank Heider",
            "homepage": "https://github.com/fheider",
            "role": "Author"
        },
        {
            "name": "Johannes Jordan",
            "homepage": "https://github.com/ypnos-web",
            "role": "Author"
        },
        {
            "name": "Xavier ZOLEZZI",
            "homepage": "https://github.com/x-zolezzi",
            "role": "Author"
        },
        {
            "name": "Umer Salman",
            "homepage": "https://github.com/umer936",
            "role": "Author"
        }
    ],
    "require": {
        "php": "^8.5",
        "cakephp/cakephp": "^5.4.4"
    },
    "require-dev": {
        "cakephp/cakephp-codesniffer": "^5.3",
        "phpunit/phpunit": "^13.4"
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "test-coverage": "phpunit --coverage-html coverage",
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "check": ["@test", "@cs-check"]
    },
    "autoload": {
        "psr-4": {
            "DataTables\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DataTables\\Test\\": "tests"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
